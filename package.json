{
  "name": "honeypot-health-check",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight Discord health-check watchdog for a main bot, built with Bun + TypeScript",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  }
}
