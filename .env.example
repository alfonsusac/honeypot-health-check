# Discord bot token for THIS watchdog bot (not the main bot)
DISCORD_TOKEN=

# Guild (server) ID where the main bot lives
GUILD_ID=

# User/application ID of the main bot being monitored
MAIN_BOT_ID=

# Channel the watchdog may optionally post a custom health-check message into
# Only used if the main bot is explicitly coded to reply to it. Leave blank to disable.
HEALTH_CHANNEL_ID=

# Channel where the watchdog posts status summaries/logs
LOG_CHANNEL_ID=

# How often to run a health check, in milliseconds
CHECK_INTERVAL_MS=60000

# How long to wait for an optional custom health-check reply, in milliseconds
TIMEOUT_MS=5000

# Port for the local HTTP API
PORT=3000
