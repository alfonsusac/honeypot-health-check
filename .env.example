# Discord bot token for THIS watchdog bot (not any of the monitored bots)
DISCORD_TOKEN=

# Guild (server) ID where the monitored bots live
GUILD_ID=

# How often to run a health check, in milliseconds
CHECK_INTERVAL_MS=60000

# Port for the local HTTP API
PORT=3000

# Page size for the paginated /bot/:botId timeline (default 50)
# The /bot/:botId/pages metadata uses the same value so clients can cache pages consistently.
PAGE_SIZE=50

# Site revalidation (optional). When set, the watchdog POSTs to REVALIDATE_URL with the
# token and a tag after a bot presence mark lands or a bot's total_pages changes,
# e.g. {"token": "...", "tag": "bot-<id>"} / "...-pages".
REVALIDATE_URL=
REVALIDATE_TOKEN=

# Channel for general watchdog logging (currently just the startup message).
# NODE_ENV (set by the `dev`/`start` npm scripts) picks which one is used,
# so local development doesn't post into your real production log channel.
LOG_CHANNEL_ID_DEV=
LOG_CHANNEL_ID_PROD=

# Which bots to monitor (and which channel to alert per bot) is configured
# directly in src/lib/config.ts via the `botTargets` map, not env vars.
